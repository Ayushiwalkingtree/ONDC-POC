# FastAPI MF Buyer NP POC
APP_NAME=ONDC MF Buyer NP POC
APP_ENV=local
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ONDC Buyer NP identity (placeholders - obtain from ONDC registry onboarding)
SUBSCRIBER_ID=your-buyer-subscriber-id.ondc.org
UNIQUE_KEY_ID=your-unique-key-id
SIGNING_PRIVATE_KEY_PATH=
ONDC_REGISTRY_URL=
ONDC_REGISTRY_TIMEOUT_SECONDS=10
REQUIRE_ONDC_AUTH=false

BAP_ID=buyer-app.example.com
BAP_URI=https://buyer-app.example.com/ondc
BAP_CALLBACK_URI=https://buyer-app.example.com/ondc

# Optional default BPP target for local development/manual tests
BPP_ID=seller-app.example.com
BPP_URI=https://seller-app.example.com/ondc

# Domain for Mutual Funds
ONDC_DOMAIN=ONDC:FIS14
ONDC_VERSION=2.0.0
